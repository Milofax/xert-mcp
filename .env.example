# XERT API Credentials

# --- Recommended (Xert API 1.7+) -------------------------------------------
# Since Xert API 1.7 the public client "xert_public" (used by setup-auth)
# returns FIXED DEMO DATA for activities and workouts.
# Create your own key in Xert: Account Settings -> Developer
#   Client Key    (xk_...)
#   Client Secret (xs_...)  - shown only once
XERT_CLIENT_ID=
XERT_CLIENT_SECRET=

# --- Legacy (xert_public, demo data for activities/workouts) ---------------
# Generated by: npm run setup-auth
# Ignored when XERT_CLIENT_ID and XERT_CLIENT_SECRET are set.
# XERT_ACCESS_TOKEN=
# XERT_REFRESH_TOKEN=
